---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { practices } from "../../data/practices";

export function getStaticPaths() {
  return practices.map((practice) => ({ params: { slug: practice.slug }, props: { practice } }));
}

const { practice } = Astro.props;
---

<BaseLayout title={`${practice.title} — «А‑ЛЕКС»`} description={practice.summary}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">{practice.eyebrow}</p>
      <h1>{practice.title}</h1>
      <p>{practice.summary}</p>
    </div>
  </section>
  <section class="section">
    <div class="shell content-grid">
      <article class="prose">
        <p>{practice.intro}</p>
        <h2>С чем мы работаем</h2>
        <ul class="service-list">{practice.services.map((service: string) => <li>{service}</li>)}</ul>
        <h2>Как начать</h2>
        <p>Опишите обстоятельства в форме. Для первичного обращения документы прикладывать не нужно. Юрист изучит описание и свяжется с вами в выбранное время.</p>
      </article>
      <aside class="sidebar-card">
        <p class="eyebrow">Первичный разбор</p>
        <h3>Нужна консультация?</h3>
        <p>Оставьте контакты и удобное время. Мы изучим ваше описание до звонка.</p>
        <a class="button" href="/#consultation">Оставить заявку</a>
        <a class="button button-outline" href="tel:+79099708373">Позвонить</a>
      </aside>
    </div>
  </section>
</BaseLayout>
