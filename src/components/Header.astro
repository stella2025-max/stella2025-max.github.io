<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="А‑ЛЕКС, на главную">
      <span class="brand-mark" aria-hidden="true">§</span>
      <span><strong>А‑ЛЕКС</strong><small>юридическая компания</small></span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav" data-menu>
      <span></span><span></span><span></span><span class="sr-only">Открыть меню</span>
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Основная навигация">
      <a href="/#about">О компании</a>
      <a href="/#practices">Практики</a>
      <a href="/#consultation">Бесплатная консультация</a>
      <a href="/articles">Материалы</a>
      <a href="/#contacts">Контакты</a>
    </nav>
    <a class="header-phone" href="tel:+79099708373">8 909 970‑83‑73</a>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu]");
  const nav = document.querySelector<HTMLElement>("#main-nav");
  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    nav?.classList.toggle("is-open", !isOpen);
  });
  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
    button?.setAttribute("aria-expanded", "false");
    nav.classList.remove("is-open");
  }));
</script>
